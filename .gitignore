node_modules/
dist/
*.log
*.tgz
.env
.env.*
!.env.example
.workspace/

# Captures from e2e runs: they carry a real md5sum, that is, md5(known prefix +
# security code). In a repository meant to be published, that is material for
# offline code cracking. They stay local; the tests use a prepared stub instead.
test/e2e/captures/

# Development host: the database, logs and process handles are run artifacts,
# not sources. The tunnel address changes on every start, so storing it in the
# repository would be litter pointing at somebody else's host.
*.pid
*.url
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dev/payload-types.ts
dev/media/

# Screenshots from the demo shop: a session artifact, not a source.
dev/screenshots/

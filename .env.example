# Credentials from the Tpay panel: Integration > API (sandbox: https://register.sandbox.tpay.com/)
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
# Security code for the md5 checksum of notifications: panel > Notifications > Security
TPAY_SECURITY_CODE=
# Merchant identifier (the number shown in the panel), goes into the md5 checksum
TPAY_MERCHANT_ID=
# true = sandbox (openapi.sandbox.tpay.com), false = production (api.tpay.com)
TPAY_SANDBOX=true

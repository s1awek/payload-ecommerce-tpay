# Dane z panelu Tpay: Integracja > API (sandbox: https://register.sandbox.tpay.com/)
TPAY_CLIENT_ID=
TPAY_CLIENT_SECRET=
# Kod bezpieczenstwa do sumy md5 powiadomien: panel > Powiadomienia > Bezpieczenstwo
TPAY_SECURITY_CODE=
# Identyfikator sprzedawcy (liczba widoczna w panelu), wchodzi do sumy md5
TPAY_MERCHANT_ID=
# true = sandbox (openapi.sandbox.tpay.com), false = produkcja (api.tpay.com)
TPAY_SANDBOX=true
